      '<a href="https://download.teamviewer.com/download/TeamViewerQS.exe" style="display:inline-block;background:#065f46;color:#fff;padding:12px 24px;border-radius:999px;text-decoration:none;font-weight:600;font-size:14px">Télécharger TeamViewer QuickSupport</a>' +
      '</div>';
  }

  var mailOptions = {
    from: '"TechAssist" <' + process.env.EMAIL_USER + '>',
